# YouCam API Configuration
YOUCAM_API_KEY=your_api_key_here
YOUCAM_BASE_URL=https://yce-api-01.makeupar.com/s2s/v2.0

# Explicit mock mode for ordinary local development; a missing key never silently mocks.
MOCK_MODE=true
NEXT_TELEMETRY_DISABLED=1

# Required when MOCK_MODE=false. Use a random 24–256 character code, shared only
# with invited preview testers. Keep server-side; never prefix NEXT_PUBLIC_.
LIVE_ACCESS_CODE=
