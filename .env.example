# YouCam API Configuration
YOUCAM_API_KEY=your_api_key_here
YOUCAM_BASE_URL=https://yce-api-01.makeupar.com/s2s/v2.0

# Explicit mock mode for ordinary local development; a missing key never silently mocks.
# Production (Vercel) runs live: do NOT set MOCK_MODE there; set YOUCAM_API_KEY instead.
MOCK_MODE=true
NEXT_TELEMETRY_DISABLED=1

# Required for live generation: one persistent shared aggregate budget, no photos.
# Initialize once with scripts/live-budget.mjs after refreshing balance/prices.
# Both routes and every deployment sharing the YouCam key must use the same store.
# Missing/exhausted/expiring budget fails closed; no automatic reset or refund.
# Vercel-managed Upstash may instead supply KV_REST_API_URL and KV_REST_API_TOKEN.
# A nonempty explicit UPSTASH_* field selects that pair; both fields must be valid.
# Do not mix the two families or substitute KV_REST_API_READ_ONLY_TOKEN.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional private 24-hour creator feedback gallery (explicit result sharing only).
# Generate a random server-only secret of at least 32 characters; never expose it as NEXT_PUBLIC_.
RESULTS_ADMIN_SECRET=
